# Firebase 웹 앱 설정 — docs/spec-sync-v0.1.md §3.5
#
# 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정 및 구성에서 firebaseConfig 값을 복사한다.
# 이 파일을 .env.local 로 복사해 채운다 (.env.local 은 git에 올라가지 않는다).
#
# 이 값들은 비밀이 아니다 — 클라이언트 번들에 그대로 들어간다. env로 받는 이유는
# 보안이 아니라 Firebase 프로젝트를 코드 수정 없이 교체·분리하기 위함이다.
# 실제 방어선은 firestore.rules 다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
