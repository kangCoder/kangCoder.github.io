{
  /* 검증 하네스 — src를 import하므로 DOM lib이 필요하고(crypto.randomUUID 등),
     tsx로 Node에서 돌리므로 node types도 필요하다. 그래서 app·node 어느 쪽에도
     끼울 수 없어 프로젝트를 따로 둔다. 옵션은 tsconfig.app.json과 같게 유지한다. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* vite-env.d.ts를 함께 넣는 이유 — 하네스가 import하는 src 파일이
     import.meta.env를 쓴다. ambient 선언은 import로 끌려오지 않으므로
     include에 명시해야 한다. */
  "include": ["scripts", "src/vite-env.d.ts"]
}
